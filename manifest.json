{
  "manifest_version": 3,
  "name": "HD Jira Bridge",
  "version": "1.0.0",
  "description": "Lets HD Dashboards pull tickets straight from Jira using your browser session.",
  "permissions": ["scripting"],
  "host_permissions": ["https://svmhelpdesk.atlassian.net/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://localhost/*","http://127.0.0.1/*","https://*.github.io/*","file:///*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }]
}
